// Local-only preview config: omits the remote Workers AI binding so `npm run dev:local`
// works without Cloudflare API credentials. Production deploys use wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aminnova-local",
  "main": "src/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-08-18",
  "durable_objects": {
    "bindings": [
      { "name": "AMINCK_STORE", "class_name": "AMINCKStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AMINCKStore"] }
  ],
  "workers_dev": true,
  "preview_urls": true
}
