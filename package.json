{
  "name": "edge-panel",
  "version": "1.0.0",
  "private": true,
  "description": "AMINCK Nova Edge (GOD Edition) — Persian RTL serverless edge panel for VLESS + WS + TLS subscriptions on Cloudflare Workers. Anti-detect, Zooz/BPB multi-port, one-click hot-update, Durable Object AMINCK_STORE, mobile responsive.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run check",
    "check": "npm run check:ts && npm run check:ui",
    "check:ts": "tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "build:public": "node scripts/build-public.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "wrangler": "^4.123.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
