# AMINCK Nova Edge — example environment configuration
# Copy to .env and adjust. All values are optional; defaults are shown.

# Port the HTTP server binds to.
PORT=3000

# Interface to bind. Use 0.0.0.0 inside containers/sandboxes.
HOST=0.0.0.0

# Logging verbosity: debug | info | warn | error | silent
LOG_LEVEL=info

# Requests allowed per rate-limit window, per client key.
RATE_LIMIT_CAPACITY=100

# Rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# Max entries held in the in-memory response cache.
CACHE_MAX_ENTRIES=500

# Default cache time-to-live in milliseconds.
CACHE_TTL_MS=30000
