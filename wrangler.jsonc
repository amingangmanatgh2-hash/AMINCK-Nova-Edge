{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-guard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "NOVA", "class_name": "NovaBot" }] },
  "migrations": [{ "tag": "nova-v1", "new_sqlite_classes": ["NovaBot"] }],
  "secrets": { "required": ["PANEL_PASSWORD"] },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false },
  "minify": true
}
