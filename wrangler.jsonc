// AMINCK Nova Edge — Cloudflare Workers configuration
// Bindings:
//   AMINCK_STORE  — Durable Object (SQLite-backed) that holds ALL state:
//                   settings, users, admins, audit log, sessions, probe results.
//                   No D1, no KV and no manual provisioning required: the
//                   migration below creates the class automatically on deploy.
// Required secret (the official Deploy button asks for it automatically):
//   ADMIN_PASSWORD — password of the owner (username: AMINCK)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aminnova",
  "main": "src/index.ts",
  // Panel UI as Workers Static Assets (generated from src/ui.ts via
  // `npm run build:public`). run_worker_first keeps ALL requests in the
  // Worker so security headers and auth apply to every response; the
  // Worker serves the files through the ASSETS binding.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [],
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  // Optional, operator-triggered profile advice. Auto Build never depends on
  // inference: if quota/model access is unavailable it keeps deterministic
  // probe-based defaults and completes normally.
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AMINCK_STORE",
        "class_name": "AMINCKStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AMINCKStore"]
    }
  ],
  // Keep workers.dev and preview URLs explicit so Wrangler does not emit
  // first-deploy warnings. Endpoint probing is run by the panel's automatic
  // builder and the manual Probe action, requiring no account-level Cron slot.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "minify": true,
  "logpush": false
}
